# Same bytes on Windows and Mac: shell scripts must stay LF, the Windows launcher CRLF.
* text=auto eol=lf
*.sh      text eol=lf
*.command text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf
setup/portable/*.cmd text eol=lf
*.ttf binary
# Keep upstream license wording/spacing; text still uses LF in the repository.
studio/openmc_studio/static/fonts/*-OFL.txt text eol=lf -whitespace

*.h5 binary
*.xz binary

# CAD fixtures are engine or writer output kept byte for byte (their hashes are recorded);
# FreeCAD writes trailing spaces, so whitespace checks do not apply to them.
test/fixtures/cad/**/*.step text eol=lf -whitespace
